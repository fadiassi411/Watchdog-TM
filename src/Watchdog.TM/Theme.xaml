<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Ink" Color="#14212B"/><SolidColorBrush x:Key="Muted" Color="#6A7884"/>
<Style TargetType="Button"><Setter Property="Background" Value="#0C8C84"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,3"/><Setter Property="BorderBrush" Value="#CBD6DA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,3"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD6DA"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,12,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="Expander"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Padding" Value="4"/><Setter Property="Foreground" Value="#14212B"/></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="#F3F6F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,12,0,0"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#14212B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="White" BorderBrush="#DCE4E7" BorderThickness="1" CornerRadius="16" Margin="3,3,6,3" Padding="16,8"><ContentPresenter x:Name="TabLabel" ContentSource="Header" TextElement.Foreground="#526570"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#0C8C84"/><Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBox"><Setter Property="BorderBrush" Value="#DCE4E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="White"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4E7"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F8F9"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E6ECEE"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/></Style>
</ResourceDictionary>

